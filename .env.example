APP_NAME="ALMARA Gateway WA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://wagateway-almara.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wagateway_almara
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = pesan langsung dikirim saat request (paling sederhana untuk lokal).
# Produksi: ganti ke database/redis lalu jalankan: php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ---------------------------------------------------------------
# ALMARA Gateway WA
# ---------------------------------------------------------------
# Akun admin awal (dipakai oleh: php artisan db:seed). Segera ganti password setelah login.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ubah-password-ini

# Batas request API per API key per menit
WA_API_RATE_LIMIT=60

# Meta Cloud API (WhatsApp Business Platform)
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
# Token verifikasi webhook (bebas, samakan dengan yang diisi di Meta App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=
# App Secret Meta untuk validasi signature webhook (X-Hub-Signature-256)
META_APP_SECRET=

# Engine QR (scan barcode) — folder engine/ (Node.js). Token harus sama dengan ENGINE_TOKEN di engine/.env
WA_ENGINE_URL=http://127.0.0.1:3000
WA_ENGINE_TOKEN=ganti-dengan-token-acak-panjang
