# ALMARA WA Engine — @2026-Alifiandra
# Port engine (gateway Laravel memanggil http://127.0.0.1:PORT)
PORT=3000
# Hanya dengarkan localhost. Jangan buka ke internet.
HOST=127.0.0.1
# Token rahasia — samakan dengan WA_ENGINE_TOKEN di .env Laravel
ENGINE_TOKEN=ganti-dengan-token-acak-panjang
# Level log: fatal | error | warn | info | debug
LOG_LEVEL=warn
