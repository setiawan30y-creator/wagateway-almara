    "/v1/messages/media": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Kirim media (gambar / dokumen / audio / video)",
        "operationId": "sendMedia",
        "description": "multipart/form-data. Maks. 16 MB. Ekstensi: jpg, jpeg, png, webp, pdf, doc(x), xls(x), ppt(x), txt, csv, zip, mp3, ogg, m4a, aac, amr, opus, mp4, 3gp.",
